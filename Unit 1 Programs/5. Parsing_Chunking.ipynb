      "source": [
        "import re\n",
        "import spacy\n",
        "\n",
        "text = \"The quick brown fox jumps over the dog.\"\n",
        "\n",
        "# Regex\n",
        "print(\"Words:\", re.findall(r'\\w+', text))\n",
        "\n",
        "# spaCy chunking\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "doc = nlp(text)\n",
        "\n",
        "for chunk in doc.noun_chunks:\n",
        "    print(\"Chunk:\", chunk.text)"
      ]
    }
  ]
}